        {
            "name": "heatingdemand_profile_is_set",
            "description": "Report errors if HeatingDemand assets do not have InPort profile properly defined",
            "type": "error",
            "message": "InPort heating demand profile [Power in MW] or [Power in kW] is missing or incorrectly defined.",
            "selects": [
                {
                    "function": "get_references",
                    "alias": "heatingDemandInPorts",
                    "args": {
                        "assetType": "HeatingDemand",
                        "referenceType": "InPort"
                    }
                }
            ],
            "check": {
                "function": "attributes_validation",
                "dataset": "heatingDemandInPorts",
                "args": {
                    "ref": {
                        "path": "profile",
                        "ref_list_filter": {
                            "is_type": ["InfluxDBProfile", "DataTableProfile"]
                        }
                    },
                    "null_checks": [
                        { "attribute": "multiplier", "count_as_null": [0.0] },
                        { "attribute": "profileQuantityAndUnit", "count_as_null": [] }
                    ],
                    "valid_checks": [
