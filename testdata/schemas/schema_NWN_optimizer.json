{
    "name": "Optimizer validation schema",
    "description": "Schema to validate optimizer requirements",
    "pre_validation_schemas": ["NWN general validation schema"],
    "validations": [
        {
            "name": "supply_return_combination",
            "description": "Heat commodities must have a name with '_ret' for the return part",
            "type": "error",
            "message": "HeatCommodity must have a paired entity. (A combination of supply and return parts, and with a suffix of _ret on the return entity name)",
            "selects": [{
                    "function": "get",
                    "alias": "heat_commodities",
                    "args": {
                        "type": ["HeatCommodity"],
                        "property": ["name"]
                    }
                }
            ],
            "check": {
                "function": "has_pair",
                "dataset": "heat_commodities",
                "args": {
                    "property": "name",
                    "keyword": "_ret",
                    "resultMsgJSON": true
                }
            }
        },
        {
            "name": "pipe_supply_return_combination",
            "description": "Report a warning if a pipe does not have a (e.g., supply and return) related part specified",
            "type": "warning",
            "message": "The pipe is missing a related supply or return entity.",
            "selects": [
                {
                    "function": "get",
                    "alias": "assets",
                    "args": {
                        "type": ["Pipe"]
                    }
                }
            ],
            "check": {
                "function": "attributes_validation",
                "dataset": "assets",
                "args": {
                    "null_checks": [
                        {
                            "attribute": "related",
                            "count_as_null": [""]
                        }
                    ],
                    "valid_checks": [],
                    "resultMsgJSON": true
                }
            }
        },
        {
            "name": "pipe_diameter_validation",
            "description": "Report warnings if the Pipe diameter is not valid",
            "type": "warning",
            "message": "For OPTIONAL pipes, the minimum diameter is DN150. This limit does not apply when the pipe state is ENABLED.",
            "selects": [{
                    "function": "get",
                    "alias": "pipes",
                    "args": {
                        "type": ["Pipe"]
                    }
                }
            ],
            "check": {
                "function": "attributes_validation",
                "dataset": "pipes",
                "args": {
                    "null_checks": [],
                    "valid_checks": [
                        {
                            "attribute": "diameter",
                            "count_as_valid": ["DN150", "DN200", "DN250", "DN300", "DN350", "DN400", "DN450", "DN500", "DN600", "DN650", "DN700", "DN800", "DN900", "DN1000", "DN1100", "DN1200"]
                        }
                    ],
                    "resultMsgJSON": true
                }
            }
        },
        {
            "name": "ATES_required_attributes_for_optimizer_use_are_set",
            "description": "Report errors if the required attributes of ATES assets for optimizer use are not set.",
            "type": "error",
            "message": "Required attribute not set",
            "selects": [
                {
                    "function": "get",
                    "alias": "ates",
                    "args": {
                        "type": ["ATES"]
                    }
                }
            ],
            "check": {
                "function": "attributes_validation",
                "dataset": "ates",
                "args": {
                    "null_checks": [
                        {
                            "attribute": "name",
                            "count_as_null": [""]
                        }
                    ],
                    "valid_checks": [],
                    "resultMsgJSON": true
                }
            }
        },
        {
            "name": "heatexchange_required_attributes_for_optimizer_use_are_set",
            "description": "Report errors if the required attributes of HeatExchange assets for optimizer use are not set or incorrectly set.",
            "type": "error",
            "message": "Required attribute not set or invalid",
            "selects": [{
                    "function": "get",
                    "alias": "heatexchanges",
                    "args": {
                        "type": ["HeatExchange"]
                    }
                }
            ],
            "check": {
                "function": "attributes_validation",
                "dataset": "heatexchanges",
                "args": {
                    "null_checks": [
                        {
                            "attribute": "name",
                            "count_as_null": [""]
                        },
                        {
                            "attribute": "capacity",
                            "count_as_null": [0.0]
                        }
                    ],
                    "valid_checks": [
                        {
                            "attribute": "efficiency",
                            "in_range": {
                                "min_exclusive": 0.0,
                                "max": 1.0
                            }
                        }
                    ],
                    "resultMsgJSON": true
                }
            }
        },
        {
            "name": "required_investmentCosts_EUR_MW_or_kW_are_set",
            "description": "Report errors if costInformation.investmentCosts [EUR/MW] or [EUR/kW] are not set or incorrectly set for the defined assets.",
            "type": "error",
            "message": "Investment Costs [EUR/MW] or [EUR/kW] is incomplete or incorrect",
            "selects": [
                {
                    "function": "get",
                    "alias": "assets",
                    "args": {
                        "type": ["HeatPump", "GasHeater", "ElectricBoiler", "HeatProducer", "ATES", "HeatExchange"]
                    }
                }
            ],
            "check": {
                "function": "attributes_validation",
                "dataset": "assets",
                "args": {
                    "null_checks": [
                        { "attribute": "costInformation.investmentCosts.value", "count_as_null": [0.0] }
                    ],
                    "valid_checks": [],
                    "resultMsgJSON": true
                },
                "and": [
                    {
                        "function": "attributes_validation",
                        "args": {
                            "ref": { 
                                "path": "costInformation.investmentCosts.profileQuantityAndUnit" 
                            },
                            "null_checks": [],
                            "valid_checks": [
                                { "attribute": "unit", "count_as_valid": "EURO" },
                                { "attribute": "perUnit", "count_as_valid": "WATT" },
                                { "attribute": "perMultiplier", "count_as_valid": ["MEGA", "KILO"] },
                                { "attribute": "perTimeUnit", "count_as_valid": "Unset" }
                            ],
                            "resultMsgJSON": true
