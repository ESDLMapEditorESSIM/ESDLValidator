        {
            "name": "connected_as_producer",
            "description": "Find if assets are connected as producers (Outport on supply network). HeatProducer also includes GeothermalSource and ResidualHeatSource",
            "type": "error",
            "message": "Asset is not connected as producer. Check if ports or carriers have been added properly (InPort with return carrier assigned; OutPort with supply carrier assigned; Temperature of OutPort should be greater than Temperature of InPort)",
            "selects": [{
                    "function": "get",
                    "alias": "assets",
                    "args": {
                        "type": ["HeatProducer"],
                        "exclude_type": ["SolarCollector"]
                    }
                }
            ],
            "check": {
                "function": "reference_count_in_range",
                "dataset": "assets",
                "args": {
                    "referenceType": "port",
                    "min": 2,
                    "max": 2,
                    "resultMsgJSON": true
                },
                "and": [
                    {
                        "function": "compare_reference_attributes",
                        "args": {
                            "ref": "port",
                            "left": {
                                "ref_filter": {
                                    "is_type": "OutPort",
                                    "match": { "name": "Out" }
                                },
                                "attribute": "carrier.supplyTemperature"
                            },
                            "operator": "greater_than",
                            "right": {
                                "ref_filter": {
                                    "is_type": "InPort",
                                    "match": { "name": "In" }
                                },
                                "attribute": "carrier.returnTemperature"
                            },
                            "resultMsgJSON": true
                        }
                    }
                ]
            }
        },
        {
            "name": "connected_as_consumer",
            "description": "Find if assets are connected as consumers (InPort on supply network)",
            "type": "error",
            "message": "Asset is not connected as consumer. Check if ports or carriers have been added properly (InPort with supply carrier assigned; OutPort with return carrier assigned; Temperature of InPort should be greater than Temperature of OutPort)",
            "selects": [{
                    "function": "get",
                    "alias": "assets",
                    "args": {
                        "type": ["HeatingDemand", "HeatStorage"]
                    }
                }
            ],
            "check": {
