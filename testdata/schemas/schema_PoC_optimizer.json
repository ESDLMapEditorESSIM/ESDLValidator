{
    "name": "PoC extended schema to support optimizer requirements",
    "description": "PoC extended schema to support optimizer asset attributes check",
    "validations": [
        {
            "name": "supported_assets",
            "description": "Report errors if the ESDL contains assets which are not included in the supported asset list.",
            "type": "error",
            "message": "Unsupported Asset",
            "selects": [
                {
                    "function": "get",
                    "alias": "assets",
                    "args": {
                        "type": ["EnergyAsset"]
                    }
                }
            ],
            "check": {
                "function": "is_supported_types",
                "dataset": "assets",
                "args": {
                    "types": [
                        "HeatPump",
                        "HeatProducer",
                        "GeothermalSource",
                        "ResidualHeatSource",
                        "HeatingDemand",
                        "HeatStorage",
                        "ATES",
                        "Pipe",
                        "HeatExchange",
                        "Joint"
                    ],
                    "resultMsgJSON": true
                }
            }
        },
        {
            "name": "heatpump_required_attributes_are_set",
            "description": "Report errors if the required attributes of HeatPump are not set.",
            "type": "error",
            "message": "Required Attribute Not Set",
            "selects": [{
                    "function": "get",
                    "alias": "heatpumps",
                    "args": {
                        "type": ["HeatPump"]
                    }
                }
            ],
            "check": {
                "function": "attributes_not_null",
                "dataset": "heatpumps",
                "args": {
                    "checks": [
                        {
                            "attribute": "name",
                            "count_as_null": [""]
                        },
                        {
                            "attribute": "power",
                            "count_as_null": [0.0]
                        },
                        {
                            "attribute": "COP",
                            "count_as_null": [0.0]
                        }
                    ],
                    "resultMsgJSON": true
                }
            }
        },
        {
            "name": "producers_required_attributes_are_set",
            "description": "Report errors if the required attributes of heat producer assets are not set. HeatProducer also includes GeothermalSource and ResidualHeatSource",
            "type": "error",
            "message": "Required Attribute Not Set",
            "selects": [{
                    "function": "get",
                    "alias": "producers",
                    "args": {
                        "type": ["HeatProducer"],
                        "exclude_type": ["SolarCollector"]
                    }
                }
            ],
            "check": {
                "function": "attributes_not_null",
                "dataset": "producers",
                "args": {
                    "checks": [
                        {
                            "attribute": "name",
                            "count_as_null": [""]
                        },
                        {
                            "attribute": "power",
                            "count_as_null": [0.0]
                        }
                    ],
                    "resultMsgJSON": true
                }
            }
        },
        {
            "name": "heatingdemand_required_attributes_are_set",
            "description": "Report errors if the required attributes of HeatingDemand assets are not set.",
            "type": "error",
            "message": "Required Attribute Not Set",
            "selects": [{
                    "function": "get",
                    "alias": "heatingdemands",
