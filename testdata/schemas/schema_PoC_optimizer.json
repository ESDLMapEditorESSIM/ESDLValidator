                            "ref": "port",
                            "left": {
                                "ref_filter": {
                                    "is_type": "InPort",
                                    "match": { "name": "In" }
                                },
                                "attribute": "carrier.supplyTemperature"
                            },
                            "operator": "greater_than",
                            "right": {
                                "ref_filter": {
                                    "is_type": "OutPort",
                                    "match": { "name": "Out" }
                                },
                                "attribute": "carrier.returnTemperature"
                            },
                            "resultMsgJSON": true
                        }
                    }
                ]
            }
        },
        {
            "name": "required_investmentCosts_EUR_MW_or_kW_are_set",
            "description": "Report errors if costInformation.investmentCosts [EUR/MW] or [EUR/kW] are not set or incorrectly set for the defined assets.",
