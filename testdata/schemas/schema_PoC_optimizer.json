                            "checks": [
                                { "attribute": "unit", "count_as_valid": "EURO" },
                                { "attribute": "perUnit", "count_as_valid": "CUBIC_METRE" },
                                { "attribute": "perMultiplier", "count_as_valid": "Unset" },
                                { "attribute": "perTimeUnit", "count_as_valid": "Unset" }
                            ],
