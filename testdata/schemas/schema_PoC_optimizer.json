                        "type": ["HeatingDemand"]
                    }
                }
            ],
            "check": {
                "function": "attributes_not_null",
                "dataset": "heatingdemands",
                "args": {
                    "checks": [
                        {
                            "attribute": "name",
                            "count_as_null": [""]
                        },
                        {
                            "attribute": "power",
                            "count_as_null": [0.0]
                        }
                    ],
                    "resultMsgJSON": true
