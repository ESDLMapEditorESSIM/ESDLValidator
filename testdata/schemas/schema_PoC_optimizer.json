                        },
                        {
                            "attribute": "maxDischargeRate",
                            "count_as_null": [0.0]
                        },
                        {
                            "attribute": "volume",
                            "count_as_null": [0.0]
                        }
                    ],
                    "resultMsgJSON": true
                }
            }
        },
