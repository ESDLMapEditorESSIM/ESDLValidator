{
    "name": "Simulator validation schema",
    "description": "Schema to validate simulator requirements",
    "pre_validation_schemas": ["NWN general validation schema"],
    "validations": [
        {
            "name": "ATES_required_attributes_for_simulator_use_are_set",
            "description": "Report errors if the required attributes of ATES assets for simulator use are not set.",
            "type": "error",
            "message": "Required attribute not set",
            "selects": [
                {
                    "function": "get",
                    "alias": "ates",
                    "args": {
                        "type": ["ATES"]
                    }
                }
            ],
            "check": {
                "function": "attributes_validation",
                "dataset": "ates",
                "args": {
                    "null_checks": [
                        {
                            "attribute": "name",
                            "count_as_null": [""]
                        },
                        {
                            "attribute": "maxChargeRate",
                            "count_as_null": [0.0]
                        },
                        {
                            "attribute": "maxDischargeRate",
                            "count_as_null": [0.0]
                        },
                        {
                            "attribute": "aquiferTopDepth",
                            "count_as_null": [0.0]
                        },
                        {
                            "attribute": "aquiferThickness",
                            "count_as_null": [0.0]
                        },
                        {
                            "attribute": "aquiferMidTemperature",
                            "count_as_null": [0.0]
                        },
                        {
                            "attribute": "aquiferPorosity",
                            "count_as_null": [0.0]
                        },
                        {
                            "attribute": "aquiferPermeability",
                            "count_as_null": [0.0]
                        },
                        {
                            "attribute": "aquiferAnisotropy",
                            "count_as_null": [0.0]
                        },
                        {
                            "attribute": "salinity",
                            "count_as_null": [0.0]
                        },
                        {
                            "attribute": "wellCasingSize",
                            "count_as_null": [0.0]
                        },
                        {
                            "attribute": "wellDistance",
                            "count_as_null": [0.0]
                        }
                    ],
                    "valid_checks": [],
                    "resultMsgJSON": true
                }
            }
        },
        {
            "name": "heatexchange_required_attributes_for_simulator_use_are_set",
            "description": "Report errors if the required attributes of HeatExchange assets for simulator use are not set or incorrectly set.",
            "type": "error",
            "message": "Required attribute not set or invalid",
            "selects": [{
                    "function": "get",
                    "alias": "heatexchanges",
                    "args": {
                        "type": ["HeatExchange"]
                    }
                }
            ],
            "check": {
                "function": "attributes_validation",
                "dataset": "heatexchanges",
                "args": {
                    "null_checks": [
                        {
                            "attribute": "name",
                            "count_as_null": [""]
                        }
                    ],
                    "valid_checks": [
                        {
                            "attribute": "efficiency",
                            "in_range": {
                                "min_exclusive": 0.0,
                                "max": 1.0
                            }
                        }
                    ],
                    "resultMsgJSON": true
                }
            }
        }
    ]
}